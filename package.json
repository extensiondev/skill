{
  "name": "@extension.dev/skill",
  "type": "module",
  "version": "1.4.2",
  "description": "The Agent Skill that teaches your AI agent to build, debug and publish browser extensions for Chrome, Firefox, Edge and Safari.",
  "license": "Apache-2.0",
  "author": {
    "name": "Cezar Augusto",
    "email": "hello@extension.dev",
    "url": "https://cezaraugusto.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extensiondev/skill.git"
  },
  "bugs": {
    "url": "https://github.com/extensiondev/skill/issues"
  },
  "homepage": "https://extension.dev",
  "engines": {
    "node": ">=20.18"
  },
  "packageManager": "pnpm@10.19.0",
  "files": [
    "skills",
    ".claude-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md"
  ],
  "agents": {
    "skills": [
      "./skills/browser-extension"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:check": "node scripts/build-plugin.mjs --check",
    "plugin:pin": "node scripts/build-plugin.mjs --pin",
    "test": "node --test --import ./test/setup/network-guard.preload.mjs test/*.test.mjs",
    "test:live": "SKILL_LIVE_REGISTRY=1 node --test test/templates-sync.test.mjs test/mcp-sync.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "agent-skill",
    "agent-skills",
    "claude-skill",
    "skills",
    "anthropic",
    "claude",
    "claude-code",
    "cursor",
    "github-copilot",
    "codex",
    "ai-agent",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-extension",
    "safari-web-extension",
    "manifest-v3",
    "webextension",
    "cross-browser",
    "extension.dev",
    "extension.js"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  }
}
